# ===================================================================
# APPLICATION ENVIRONMENT VARIABLES (.env.example)
# ===================================================================

# App Base URL (Used for generating short link URLs)
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Auth & Session Encryption Key
SESSION_SECRET="super-secret-random-key-change-this-in-production"

# PostgreSQL Database Connection String (Neon.tech / Supabase / Local Docker Postgres)
# Local Docker Postgres Example: "postgres://postgres:postgres@localhost:5432/shortly_db"
# Neon Cloud Postgres Example: "postgres://username:password@ep-cool-host.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgres://username:password@localhost:5432/shortly_db"

# REDIS CACHE CONFIGURATION
# -------------------------------------------------------------------
# Option A: Local Docker Redis (Standard TCP socket: redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# Option B: Upstash Cloud Serverless Redis REST API (https://upstash.com)
UPSTASH_REDIS_REST_URL="https://your-redis-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXX...XXX="
